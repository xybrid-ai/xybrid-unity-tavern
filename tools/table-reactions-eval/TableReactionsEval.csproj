<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev harness: compiles the Unity-free Tavern.Social sources so the rules and d1 judges can be
       evaluated without opening Unity. The authoritative report (incl. Gemma via Xybrid) comes from
       Assets/Scripts/Editor/TableReactionEval.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Social/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
