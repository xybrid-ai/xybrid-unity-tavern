  "setting": "The Rusty Flagon tavern in Millbrook, evening. Master Wu sits at a corner table with his two students, Shara and Varien.",
  "members": [
    {
      "id": "wu", "npcName": "Master Wu", "displayName": "Master Wu", "pronoun": "he",
      "aliases": ["wu", "master wu", "master", "your master", "your teacher", "teacher"],
      "facts": [
        "Ancient martial arts master who has trained warriors for sixty years; teacher of Shara and Varien.",
        "Speaks sparely and calmly and never raises his voice.",
        "Tries to temper Shara's fire and build up Varien's confidence."
      ]
    },
    {
      "id": "shara", "npcName": "Shara", "displayName": "Shara", "pronoun": "she",
      "aliases": ["shara"],
      "facts": [
        "Young woman in her early twenties; Master Wu's student for three years.",
        "Enthusiastic, loud and optimistic; doesn't know when to be quiet.",
        "Just landed her first flying crescent kick; a former blacksmith's apprentice.",
        "Idolizes Varien's technique but wishes he'd speak up more; adores Master Wu; sees the best in everyone."
      ]
    },
    {
      "id": "varien", "npcName": "Varien", "displayName": "Varien", "pronoun": "he",
      "aliases": ["varien"],
      "facts": [
        "Quiet 26-year-old; Master Wu's student for five years, longer than Shara.",
        "Specializes in defensive techniques and doesn't believe he's any good.",
        "Speaks hesitantly, apologizes, deflects compliments and compares himself unfavorably to others.",
        "Secretly admires Shara's confidence and hangs on every word Master Wu says."
      ]
    }
  ],
